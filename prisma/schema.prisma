// Prisma 7: connection URL lives in prisma.config.ts, the client uses a driver adapter.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerName    String      @default("")
  customerPhone   String      @default("")
  customerEmail   String      @default("")
  address         String      @default("")
  city            String      @default("")
  county          String      @default("")
  postalCode      String      @default("")
  total           Float
  shippingCost    Float
  // PENDING | PAID | SHIPPED | COMPLETED | CANCELLED
  status          String      @default("PENDING")
  paymentMethod   String      @default("card")
  stripeSessionId String?     @unique
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  size        String
  quantity    Int
  price       Float
}

// A product size the admin marked as out of stock by hand (e.g. sold outside the site).
// The row's presence is the flag; deleting it puts the size back on sale.
model SoldOutVariant {
  productId String
  size      String
  createdAt DateTime @default(now())

  @@id([productId, size])
}

// Units of a product size sold outside the site (OLX, in person); reduces available stock.
model ExternalSale {
  productId String
  size      String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([productId, size])
}
